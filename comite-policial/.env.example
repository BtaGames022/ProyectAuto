# Plantilla de configuración. Copiar a ".env" y ajustar valores.
APP_TITLE=Sistema de Automatización de Informes — PDI Valparaíso
UNIDAD=Región Policial Valparaíso

ANO_ANTERIOR=2025
ANO_ACTUAL=2026
PERIODO=ENE - AGO

# true = detecta la semana actual (lunes a domingo); false = usa SEMANA_DEFAULT
SEMANA_AUTO=true
SEMANA_DEFAULT=31.AGO AL 06.SEP.026
TURNO_RESPONSABLE=PROF (A/C) Nombre APELLIDO

WINDOW_WIDTH=1400
WINDOW_HEIGHT=860

OUTPUT_DIR=output
PLANTILLA_DOCX=plantillas/plantilla_base.docx
ASSETS_DIR=assets

